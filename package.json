{
  "name": "emberhollow",
  "version": "0.5.4",
  "description": "Emberhollow: top-down pixel-art farming, crafting and adventure RPG",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "art": "uv run --directory tools/pixelart-mcp-main python ../../art/build_atlas.py",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "vite": "5.4.10",
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.decado.emberhollow",
    "productName": "Emberhollow",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "portable": {
      "artifactName": "Emberhollow-portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "Emberhollow-setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
